#!/bin/sh
# Schutz: verhindert, dass Schlüssel oder Passwörter versehentlich ins Repo gelangen.
# Wird mit  git config core.hooksPath .githooks  aktiviert (macht der Einrichtungsassistent).

# 1) Dateien, die Schlüssel enthalten, dürfen nie hochgeladen werden
verboten=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env($|\.)' | grep -v -E '\.example$')
if [ -n "$verboten" ]; then
  echo ""
  echo "STOPP: Diese Datei enthält persönliche Schlüssel und darf nicht gespeichert werden:"
  echo "$verboten" | sed 's/^/   /'
  echo "Bitte aus der Auswahl nehmen:  git restore --staged <Datei>"
  echo ""
  exit 1
fi

# 1b) Eigene Referenzen (Fotos von Teilnehmern, Umsatz-Screenshots) gehören nicht in ein öffentliches Repo
privat=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^deck/referenzen/')
if [ -n "$privat" ]; then
  echo ""
  echo "STOPP: Dieses Repo ist öffentlich. Dateien in deck/referenzen/ bleiben nur auf deinem Rechner:"
  echo "$privat" | sed 's/^/   /'
  echo "Bitte aus der Auswahl nehmen:  git restore --staged <Datei>"
  echo ""
  exit 1
fi

# 2) Typische Schlüssel-Formate im Text
if git diff --cached -U0 | grep -E '^\+' | grep -v '^+++' | grep -E -q \
   'AIza[0-9A-Za-z_-]{30,}|sk-[A-Za-z0-9_-]{24,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
  echo ""
  echo "STOPP: In den Änderungen steht etwas, das wie ein Schlüssel oder Passwort aussieht."
  echo "Bitte entfernen. Falls es ein Fehlalarm ist, bitte Simon fragen."
  echo ""
  exit 1
fi
exit 0
